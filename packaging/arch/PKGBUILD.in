pkgname=cockpit-nixos-manager
pkgver=VERSION
pkgrel=1
pkgdesc='Declarative NixOS management for Cockpit'
arch=('x86_64')
url='https://github.com/JuanDelPueblo/cockpit-nixos-manager'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
